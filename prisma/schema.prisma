generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId    String  @id @default(cuid())
  userName  String?
  name      String
  email     String  @unique
  cpf       String? @unique
  telefone  String?
  avatarUrl String?
  role      Role    @default(USUARIO)

  // --- Campos de Segurança ---
  password             String?
  lastLogin            DateTime?
  tokenVersion         Int       @default(1)
  refreshToken         String?
  refreshTokenExpiresAt DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // --- Campos de Controle ---
  active          Boolean   @default(true)
  blocked         Boolean   @default(false)
  blockedUntil    DateTime?
  loginAttempts   Int       @default(0)
  lastFailedLogin DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Saldos separados para votos comuns e super votos
  votosDisponiveisComum Int @default(0)
  votosUtilizadosComum  Int @default(0)
  votosDisponiveisSuper Int @default(0)
  votosUtilizadosSuper  Int @default(0)

  // --- Relações ---
  enderecos    Endereco[]
  cadastrosCao CadastroCao[]
  artigos      Artigo[]
  comentarios  Comentario[]
  votos        Voto[]

  @@map("users")
}

model Comentario {
  comentarioId String   @id @default(cuid())
  conteudo     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  artigoId     String
  artigo       Artigo   @relation(fields: [artigoId], references: [artigoId], onDelete: Cascade)
  autorId      String
  autor        User     @relation(fields: [autorId], references: [userId], onDelete: Cascade)

  @@map("comentarios")
}

model Artigo {
  artigoId       String          @id @default(cuid())
  titulo         String
  conteudo       Json
  resumo         String?
  autorId        String
  autor          User            @relation(fields: [autorId], references: [userId])
  categoria      CategoriaArtigo
  status         StatusArtigo    @default(RASCUNHO)
  dataPublicacao DateTime
  imagemCapa     String?
  visualizacoes  Int             @default(0)
  curtidas       Int             @default(0)
  destaque       Boolean         @default(false)
  tags           String[]        @default([])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  comentarios    Comentario[]
  views          ArtigoView[]
  likes          ArtigoCurtida[]

  @@map("artigos")
}

model ArtigoView {
  viewId       String   @id @default(cuid())
  artigoId     String
  artigo       Artigo   @relation(fields: [artigoId], references: [artigoId], onDelete: Cascade)
  userId       String?
  fingerprint  String
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([artigoId])
  @@index([fingerprint, artigoId])
  @@map("artigo_views")
}

model ArtigoCurtida {
  curtidaId   String   @id @default(cuid())
  artigoId    String
  artigo      Artigo   @relation(fields: [artigoId], references: [artigoId], onDelete: Cascade)
  userId      String?
  fingerprint String
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@unique([fingerprint, artigoId])
  @@index([artigoId])
  @@map("artigo_curtidas")
}

enum CategoriaArtigo {
  NUTRICAO
  CUIDADOS
  SAUDE
  COMPORTAMENTO
  TREINAMENTO
  RACAS
  NOTICIAS
  OUTROS
}

enum Role {
  USUARIO
  DONO_PET_APROVADO
  ASSINANTE
  DONO_PET_APROVADO_ASSINANTE
  ADMIN
  EDITOR
  FUNCIONARIO
  JURADO
}

// Tipo de voto para diferenciar votos comuns e super votos
enum VotoTipo {
  COMUM
  SUPER
}

model Endereco {
  enderecoId      String   @id @default(cuid())
  userId          String
  nome            String?
  logradouro      String
  numero          String
  complemento     String?
  bairro          String
  cidade          String
  estado          String
  cep             String
  pontoReferencia String?
  principal       Boolean  @default(false)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("enderecos")
}

enum StatusArtigo {
  PUBLICADO
  RASCUNHO
  REVISAO
}

enum SexoCao {
  MACHO
  FEMEA
}

enum VideoOption {
  UPLOAD
  URL
  WHATSAPP
  NONE
}

model CadastroCao {
  cadastroId       String      @id @default(cuid())
  userId           String
  nome             String
  sexo             SexoCao
  dataNascimento   DateTime
  fotoPerfil       String
  fotoLateral      String
  peso             String?
  altura           String?
  temPedigree      Boolean     @default(false)
  registroPedigree String?
  pedigreeFrente   String?
  pedigreeVerso    String?
  temMicrochip     Boolean     @default(false)
  numeroMicrochip  String?
  titulos          String?
  caracteristicas  String?
  videoOption      VideoOption @default(NONE)
  videoUrl         String?
  whatsappContato  String?
  observacoes      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  // --- Campos de Votação ---
  totalVotos       Int     @default(0)
  ativo            Boolean @default(true)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  racaId String
  raca   Raca   @relation(fields: [racaId], references: [racaId])

  // --- Relações de Votação ---
  votos Voto[]

  @@map("cadastros_cao")
}

model Raca {
  racaId    String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cadastrosCao CadastroCao[]

  @@map("raca")
}

model Edicao {
  edicaoId  String    @id @default(cuid())
  titulo    String
  descricao String?
  data      DateTime
  pdfUrl    String
  capaUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("edicoes")
}

model Voto {
  votoId      String   @id @default(cuid())
  userId      String
  cadastroId  String
  tipo        VotoTipo @default(COMUM)
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user     User        @relation(fields: [userId], references: [userId], onDelete: Cascade)
  cadastro CadastroCao @relation(fields: [cadastroId], references: [cadastroId], onDelete: Cascade)

  // Um voto por tipo por usuário para cada cão
  @@unique([userId, cadastroId, tipo])
  @@map("votos")
}

model KardexVoto {
  kardexId    String      @id @default(cuid())
  userId      String
  cadastroId  String
  acao        AcaoKardex
  tipo        VotoTipo?
  ip          String?
  userAgent   String?
  observacoes String?
  createdAt   DateTime    @default(now())

  @@map("kardex_votos")
}

enum AcaoKardex {
  VOTO_CRIADO
  VOTO_REMOVIDO
  VOTO_INVALIDADO
  USUARIO_BLOQUEADO
  CADASTRO_DESATIVADO
}
