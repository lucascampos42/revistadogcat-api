generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId    String  @id @default(cuid())
  userName  String?
  name      String
  email     String  @unique
  cpf       String? @unique
  telefone  String?
  avatarUrl String?
  role      Role    @default(USUARIO)

  // --- Campos de Segurança ---
  password             String?
  lastLogin            DateTime?
  tokenVersion         Int       @default(1)
  refreshToken         String?
  refreshTokenExpiresAt DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // --- Campos de Controle ---
  active          Boolean   @default(true)
  blocked         Boolean   @default(false)
  blockedUntil    DateTime?
  loginAttempts   Int       @default(0)
  lastFailedLogin DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // --- Relações ---
  logs         Log[]
  enderecos    Endereco[]
  cadastrosCao CadastroCao[]
  artigos      Artigo[]
  comentarios  Comentario[]

  @@map("users")
}

model Comentario {
  comentarioId String   @id @default(cuid())
  conteudo     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  artigoId     String
  artigo       Artigo   @relation(fields: [artigoId], references: [artigoId], onDelete: Cascade)
  autorId      String
  autor        User     @relation(fields: [autorId], references: [userId], onDelete: Cascade)

  @@map("comentarios")
}

model Artigo {
  artigoId       String          @id @default(cuid())
  titulo         String
  conteudo       Json
  resumo         String?
  autorId        String
  autor          User            @relation(fields: [autorId], references: [userId])
  categoria      CategoriaArtigo
  status         StatusArtigo    @default(RASCUNHO)
  dataPublicacao DateTime
  imagemCapa     String?
  visualizacoes  Int             @default(0)
  curtidas       Int             @default(0)
  destaque       Boolean         @default(false)
  tags           String[]        @default([])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  comentarios    Comentario[]

  @@map("artigos")
}

enum CategoriaArtigo {
  NUTRICAO
  CUIDADOS
  SAUDE
  COMPORTAMENTO
  TREINAMENTO
  RACAS
  NOTICIAS
  OUTROS
}

enum Role {
  USUARIO
  DONO_PET_APROVADO
  ASSINANTE
  DONO_PET_APROVADO_ASSINANTE
  ADMIN
  EDITOR
  FUNCIONARIO
  JURADO
}

model Endereco {
  enderecoId      String   @id @default(cuid())
  userId          String
  nome            String?
  logradouro      String
  numero          String
  complemento     String?
  bairro          String
  cidade          String
  estado          String
  cep             String
  pontoReferencia String?
  principal       Boolean  @default(false)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("enderecos")
}

enum StatusArtigo {
  PUBLICADO
  RASCUNHO
  REVISAO
}

enum SexoCao {
  MACHO
  FEMEA
}

enum VideoOption {
  UPLOAD
  URL
  WHATSAPP
  NONE
}

model CadastroCao {
  cadastroId       String      @id @default(cuid())
  userId           String
  nome             String
  sexo             SexoCao
  dataNascimento   DateTime
  fotoPerfil       String
  fotoLateral      String
  peso             String?
  altura           String?
  temPedigree      Boolean     @default(false)
  registroPedigree String?
  pedigreeFrente   String?
  pedigreeVerso    String?
  temMicrochip     Boolean     @default(false)
  numeroMicrochip  String?
  titulos          String?
  caracteristicas  String?
  videoOption      VideoOption @default(NONE)
  videoUrl         String?
  whatsappContato  String?
  observacoes      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  racaId String
  raca   Raca   @relation(fields: [racaId], references: [racaId])

  @@map("cadastros_cao")
}

model Raca {
  racaId    String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cadastrosCao CadastroCao[]

  @@map("raca")
}

model Edicao {
  edicaoId  String    @id @default(cuid())
  titulo    String
  descricao String
  data      DateTime
  pdfUrl    String
  capaUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("edicoes")
}
