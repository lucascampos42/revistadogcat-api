meta {
  name: login
  type: http
  seq: 2
}

post {
  url: {{host}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identification": "admin@admin.com",
    "password": "12345678"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar('jwt', body.data.access_token);
  bru.setEnvVar('refreshToken', body.data.refresh_token);
}
