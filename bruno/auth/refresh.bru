meta {
  name: Refresh Token
  type: http
  seq: 5
}

post {
  url: {{host}}/auth/refresh
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar('jwt', body.data.access_token);
  bru.setEnvVar('refreshToken', body.data.refresh_token);
}
